# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/buvoli

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/0

# Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@buvoli.cz
SMTP_TLS=true

# App
APP_ENV=development
APP_BASE_URL=http://localhost:8000
